<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required by the [LibraryImport] source generators used by the native helpers -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>PhotinoNetUtils</RootNamespace>
        <Version>0.42.0</Version>
        <PackageId>PhotinoNETUtils</PackageId>
        <Description>Shared Photino.NET plumbing: tray icon, static file server, single instance, logging and small helpers.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/T2PeNBiX99wcoxKv3A4g/PhotinoNETUtils</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>photino;desktop;kestrel;tray;serilog</PackageTags>
    </PropertyGroup>

    <!-- The Windows SDK projection is only needed to create toasts that report a click; a build on
         another OS leaves it out and falls back to Photino's own notification call. -->
    <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([System.String]::Copy('$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('win')))">
        <DefineConstants>$(DefineConstants);WINDOWS_DESKTOP</DefineConstants>
        <!-- The Windows projection is only referenced by this build, and every call is behind
             OperatingSystem.IsWindows(); there is no windows TFM for the analyzer to check. -->
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([System.String]::Copy('$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('win')))">
        <PackageDownload Include="Microsoft.Windows.SDK.NET.Ref" Version="[10.0.28000.87]"/>
        <Reference Include="Microsoft.Windows.SDK.NET">
            <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.28000.87\lib\net9.0\Microsoft.Windows.SDK.NET.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="WinRT.Runtime">
            <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.28000.87\lib\net9.0\WinRT.Runtime.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PhotinoNETUtils.Generators\PhotinoNETUtils.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
        <None Include="..\PhotinoNETUtils.Generators\bin\$(Configuration)\netstandard2.0\PhotinoNETUtils.Generators.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="11.0.0"/>
        <PackageReference Include="Photino.NET" Version="4.0.16"/>
        <PackageReference Include="securifybv.ShellLink" Version="0.1.0"/>
        <PackageReference Include="Serilog" Version="4.4.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
        <PackageReference Include="Tomlyn" Version="2.11.1"/>
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required by the [LibraryImport] source generators used by the native helpers -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>PhotinoNetUtils</RootNamespace>
        <Version>0.4.0</Version>
        <PackageId>PhotinoNETUtils</PackageId>
        <Description>Shared Photino.NET plumbing: tray icon, static file server, single instance, logging and small helpers.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/T2PeNBiX99wcoxKv3A4g/PhotinoNETUtils</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>photino;desktop;kestrel;tray;serilog</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0"/>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.14"/>
        <PackageReference Include="Photino.NET" Version="4.0.16"/>
        <PackageReference Include="securifybv.ShellLink" Version="0.1.0"/>
        <PackageReference Include="Serilog" Version="4.4.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required by the [LibraryImport] source generators used by the native helpers -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>PhotinoNetUtils</RootNamespace>
        <Version>0.1.0</Version>
        <Description>Shared Photino.NET plumbing: tray icon, static file server, single instance, logging and small helpers.</Description>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.14" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

</Project>

{
  "name": "@photino-net-utils/bridge",
  "version": "0.25.1",
  "description": "Photino.NET window.external bridge shared by the desktop front-ends",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pack": "npm run build && npm pack",
    "upgrade": "node -e \"require('fs').rmSync('package-lock.json',{force:true})\" && npx npm-check-updates -u"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.2.0"
  }
}
